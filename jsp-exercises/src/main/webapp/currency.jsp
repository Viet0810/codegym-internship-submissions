<%@ page contentType="text/html;charset=UTF-8" %><html><body><h1>Chuyển đổi tiền tệ</h1><form><input type="number" step="0.01" name="usd" placeholder="USD" required><input type="number" name="rate" value="25000" required><button>Chuyển đổi</button></form><% if(request.getParameter("usd")!=null){double usd=Double.parseDouble(request.getParameter("usd"));double rate=Double.parseDouble(request.getParameter("rate"));%><p><%=usd%> USD = <%=String.format("%,.0f",usd*rate)%> VND</p><%}%></body></html>
