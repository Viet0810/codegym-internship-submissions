<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><body><h1>Quản lý người dùng</h1><form method="post"><input name="id" placeholder="ID khi cập nhật"><input name="name" placeholder="Tên" required><input type="email" name="email" placeholder="Email" required><input name="country" placeholder="Quốc gia" required><button>Lưu</button></form><table border="1" cellpadding="8"><tr><th>ID</th><th>Tên</th><th>Email</th><th>Quốc gia</th><th></th></tr><c:forEach items="${users}" var="u"><tr><td>${u.id()}</td><td>${u.name()}</td><td>${u.email()}</td><td>${u.country()}</td><td><a href="users?action=delete&id=${u.id()}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table></body></html>
