<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><style>table{border-collapse:collapse}td,th{border:1px solid #aaa;padding:8px}</style></head><body><h1>Quản lý sản phẩm</h1><form method="post"><input name="name" placeholder="Tên sản phẩm" required><input type="number" step="0.01" name="price" placeholder="Giá" required><button>Thêm</button></form><table><tr><th>ID</th><th>Tên</th><th>Giá</th><th>Thao tác</th></tr><c:forEach items="${products}" var="p"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.price}</td><td><a href="products?action=delete&id=${p.id}" onclick="return confirm('Xóa sản phẩm?')">Xóa</a></td></tr></c:forEach></table></body></html>
